table fact_plan_month
	lineageTag: 4f247db3-1358-5b95-b51b-b970c02d57c0

	/// 2027 plan contribution (revenue collected - drug cost - variable cost); slice by site, payer, drug, month. SQL twin context: site S1, full year.
	measure 'Budget Contribution' = SUM ( fact_plan_month[contribution] )
		formatString: \$#,##0
		displayFolder: Budget
		lineageTag: 18fa06ff-8378-5d35-97a1-8c34a3bb2b03

	/// 2027 planned chair infusions (demand-driven). SQL twin context: site S1, full year.
	measure 'Budget Administrations' = SUM ( fact_plan_month[admins] )
		formatString: #,##0
		displayFolder: Budget
		lineageTag: e04d10b2-8e95-5e16-b991-fb26a52428a0

	/// Plan contribution per infusion. SQL twin context: payer = commercial, site S1.
	measure 'Budget Contribution per Admin' = DIVIDE ( [Budget Contribution], [Budget Administrations] )
		formatString: \$#,##0
		displayFolder: Budget
		lineageTag: 9759da3f-bcc7-52c1-b267-12ebcda8197e

	/// Contribution after fixed suite costs. SQL twin context: site S1, full year.
	measure 'Budget Operating Margin' = [Budget Contribution] - [Budget Fixed Costs]
		formatString: \$#,##0
		displayFolder: Budget
		lineageTag: a1290127-ad8f-527a-9285-e36d7217bf3a

	column payer
		dataType: string
		summarizeBy: none
