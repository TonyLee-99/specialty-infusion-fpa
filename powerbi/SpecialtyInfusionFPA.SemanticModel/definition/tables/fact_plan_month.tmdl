	partition fact_plan_month = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(RepoPath & "\exports\fact_plan_month.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"payer", type text}, {"hcpcs", type text}, {"admins", type number}, {"drug_revenue", type number}, {"admin_revenue", type number}, {"drug_cost", type number}, {"variable_cost", type number}, {"contribution", type number}, {"site_id", type text}, {"month_start", type date}, {"item_key", type text}}, "en-US")
				in
				    Typed

