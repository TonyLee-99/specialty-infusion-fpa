table dim_market
	lineageTag: cd76f2a2-ef1c-51ce-8042-1fae85495edd

	/// Markets above the population and prescriber floors. SQL twin context: all.
	measure 'Eligible Markets' = COUNTROWS ( FILTER ( dim_market, dim_market[eligible] = TRUE () ) )
		formatString: #,##0
		displayFolder: Market
		lineageTag: 02da8941-8192-5330-af94-1b4114053cc0

	/// Share of 2,000 random weightings in which a market ranks in the top 10; select one market. SQL twin context: market = Canton-Massillon, OH.
	measure 'Share of Weightings in Top 10' = MAX ( dim_market[share_of_weightings_in_top10] )
		formatString: 0.0%
		displayFolder: Market
		lineageTag: 42771562-abd7-5056-9089-a17c857e2454

