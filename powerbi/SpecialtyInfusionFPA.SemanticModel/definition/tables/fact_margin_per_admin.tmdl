table fact_margin_per_admin
	lineageTag: daab91a1-f166-5fb3-b792-749a1b0259e1

	/// Mix-weighted Medicare FFS contribution per chair infusion (drug margin + admin fee - chair cost), 2026Q4 prices.
	measure 'Medicare Contribution per Admin' = DIVIDE ( SUMX ( fact_margin_per_admin, fact_margin_per_admin[mix_share] * fact_margin_per_admin[contribution_medicare_ffs] ), SUM ( fact_margin_per_admin[mix_share] ) )
		formatString: \$#,##0
		displayFolder: Margin
		lineageTag: 9b0e7bd4-41a8-5ef0-9fe9-60f6d2b74b5d

	/// Mix-weighted commercial contribution per chair infusion under the ASSUMED commercial contract (ASP + markup).
	measure 'Commercial Contribution per Admin' = DIVIDE ( SUMX ( fact_margin_per_admin, fact_margin_per_admin[mix_share] * fact_margin_per_admin[contribution_commercial] ), SUM ( fact_margin_per_admin[mix_share] ) )
		formatString: \$#,##0
		displayFolder: Margin
		lineageTag: 0c6f7260-449a-5f89-9bed-534c8da089b5

	/// Medicare FFS drug margin as % of collected drug revenue (ASP+6% after sequestration and coinsurance bad debt).
	measure 'Medicare Drug Margin %' = DIVIDE ( SUMX ( fact_margin_per_admin, fact_margin_per_admin[mix_share] * fact_margin_per_admin[drug_margin_medicare_ffs] ), SUMX ( fact_margin_per_admin, fact_margin_per_admin[mix_share] * fact_margin_per_admin[drug_collected_medicare] ) )
		formatString: 0.0%
		displayFolder: Margin
		lineageTag: 80b08153-9fbf-517b-abc0-ecb30fb8c492

