	partition fact_margin_per_admin = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(RepoPath & "\exports\fact_margin_per_admin.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"hcpcs", type text}, {"molecule", type text}, {"brand", type text}, {"product_type", type text}, {"admin_family", type text}, {"units_per_admin", type number}, {"dose_mg", type number}, {"payment_limit", type number}, {"asp_basis", type number}, {"asp_estimated", type logical}, {"addon_pct", type number}, {"admin_hours", type number}, {"chair_hours", type number}, {"drug_allowed_medicare", type number}, {"drug_collected_medicare", type number}, {"acquisition_cost", type number}, {"drug_margin_medicare_ffs", type number}, {"admin_allowed_medicare", type number}, {"admin_collected_medicare", type number}, {"chair_cost", type number}, {"contribution_medicare_ffs", type number}, {"drug_margin_commercial", type number}, {"contribution_commercial", type number}, {"contribution_medicaid", type number}, {"mix_share", type number}}, "en-US")
				in
				    Typed

