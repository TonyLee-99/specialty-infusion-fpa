table fact_provider_scorecard
	lineageTag: 30ee0eee-f146-5d95-ac8f-f892e3dcbf4a

	/// Region rheumatology / neurology / GI / allergy-immunology clinicians with >= 11 Medicare beneficiaries, 2024.
	measure 'Providers Scored' = COUNTROWS ( fact_provider_scorecard )
		formatString: #,##0
		displayFolder: Benchmark
		lineageTag: d19378c6-a982-55be-9539-14ee2ffbeead

	/// Median Medicare allowed per beneficiary across scored providers (filter by specialty for peer view).
	measure 'Median Allowed per Beneficiary' = MEDIAN ( fact_provider_scorecard[allowed_per_bene] )
		formatString: \$#,##0
		displayFolder: Benchmark
		lineageTag: 8f982166-178c-5bd5-8a68-2233e9242f79

	/// Providers whose 90% interval for shrunk biosimilar adoption sits above their specialty median.
	measure 'Providers Above Peer on Biosimilars' = COUNTROWS ( FILTER ( fact_provider_scorecard, fact_provider_scorecard[biosimilar_vs_peer] = "above_peer" ) )
		formatString: #,##0
		displayFolder: Benchmark
		lineageTag: 4bf3c4a1-f73d-59a6-a62e-c9eb5260f75e

