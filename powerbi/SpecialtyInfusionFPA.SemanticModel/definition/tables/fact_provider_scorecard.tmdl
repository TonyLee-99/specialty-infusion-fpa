	partition fact_provider_scorecard = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(RepoPath & "\exports\fact_provider_scorecard.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"npi", type text}, {"provider_type", type text}, {"state_abbr", type text}, {"county_fips", type text}, {"benes", Int64.Type}, {"allowed_per_bene", type number}, {"allowed_per_bene_risk_adj", type number}, {"services_per_bene", type number}, {"drug_share", type number}, {"infusion_share", type number}, {"bills_chair_infusions", type logical}, {"allowed_per_bene_pctile", type number}, {"allowed_per_bene_risk_adj_pctile", type number}, {"services_per_bene_pctile", type number}, {"drug_share_pctile", type number}, {"infusion_share_pctile", type number}, {"biosimilar_rate_shrunk", type number}, {"biosimilar_ci_lo", type number}, {"biosimilar_ci_hi", type number}, {"biosimilar_censored", type logical}, {"biosimilar_molecules", type number}, {"biosimilar_rate_pctile", type number}, {"biosimilar_vs_peer", type text}, {"risk", type number}}, "en-US")
				in
				    Typed

