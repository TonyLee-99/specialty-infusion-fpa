	partition fact_rcm_remits_SYNTHETIC = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(RepoPath & "\exports\fact_rcm_remits_SYNTHETIC.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"data_label", type text}, {"claim_id", type text}, {"remit_date", type date}, {"payer_paid", type number}, {"patient_resp", type number}, {"adj_group", type text}, {"carc_code", type text}, {"carc_group", type text}, {"denied", type logical}, {"remit_seq", Int64.Type}, {"patient_paid", type number}}, "en-US")
				in
				    Typed

