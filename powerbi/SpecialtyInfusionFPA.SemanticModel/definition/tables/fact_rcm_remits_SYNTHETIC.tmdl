/// SYNTHETIC data: revenue-cycle method demo only (ADR 0008). No business conclusion.
table fact_rcm_remits_SYNTHETIC
	lineageTag: 1265f35e-dcb6-5fb2-8a69-8247321cd70b

	/// SYNTHETIC demo: initial denials / first remits. SQL twin context: all.
	measure 'Denial Rate (SYNTHETIC)' = CALCULATE ( DIVIDE ( COUNTROWS ( FILTER ( fact_rcm_remits_SYNTHETIC, fact_rcm_remits_SYNTHETIC[denied] = TRUE () ) ), COUNTROWS ( fact_rcm_remits_SYNTHETIC ) ), fact_rcm_remits_SYNTHETIC[remit_seq] = 1 )
		formatString: 0.0%
		displayFolder: RCM (SYNTHETIC)
		lineageTag: 9f3088b2-0625-5f3c-a945-7c1d9d9fd325

	/// SYNTHETIC demo: first-pass paid without scrubber edit / claims with a first remit. SQL twin context: all.
	measure 'Clean Claim Rate (SYNTHETIC)' = VAR firsts = FILTER ( fact_rcm_remits_SYNTHETIC, fact_rcm_remits_SYNTHETIC[remit_seq] = 1 ) RETURN DIVIDE ( COUNTROWS ( FILTER ( firsts, fact_rcm_remits_SYNTHETIC[denied] = FALSE () && RELATED ( fact_rcm_claims_SYNTHETIC[scrubber_edit] ) = FALSE () ) ), COUNTROWS ( firsts ) )
		formatString: 0.0%
		displayFolder: RCM (SYNTHETIC)
		lineageTag: 1420a62b-ace4-5c96-a1fa-abe476c097c3

