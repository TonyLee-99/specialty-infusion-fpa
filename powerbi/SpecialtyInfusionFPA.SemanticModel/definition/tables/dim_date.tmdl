table dim_date
	dataCategory: Time
	lineageTag: 060ffd79-2468-5dae-8cc6-bc44d2362284

	column date
		dataType: dateTime
		isKey
		summarizeBy: none
		lineageTag: fe2d487c-a4f2-5746-a7f1-b1cc0f441d79
		sourceColumn: date

	column year
		dataType: int64
		summarizeBy: none
		lineageTag: 67f706ae-b581-59df-8140-ddda51ad7f8b
		sourceColumn: year

	column quarter_of_year
		dataType: int64
		summarizeBy: none
		lineageTag: 0e6ce07d-d438-5571-9929-63cfec9175ea
		sourceColumn: quarter_of_year

	column quarter_label
		dataType: string
		summarizeBy: none
		lineageTag: b835cb59-a6af-5e94-b5e5-f3d0ec426b90
		sourceColumn: quarter_label

	column month
		dataType: int64
		summarizeBy: none
		lineageTag: dd4f6242-cfd1-53bf-a50a-f8b0842f8c32
		sourceColumn: month

	column month_name
		dataType: string
		summarizeBy: none
		lineageTag: cf7389d8-e69d-5722-9ceb-360ad6bc3c1f
		sourceColumn: month_name

	partition dim_date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(RepoPath & "\exports\dim_date.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"date", type date}, {"year", Int64.Type}, {"quarter_of_year", Int64.Type}, {"quarter_label", type text}, {"month", Int64.Type}, {"month_name", type text}}, "en-US")
				in
				    Typed

