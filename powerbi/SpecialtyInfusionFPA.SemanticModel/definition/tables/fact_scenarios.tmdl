table fact_scenarios
	lineageTag: 401bf114-084c-51af-9978-b3b0a136494f

	/// Annual contribution of the 12-chair suite; use fact_scenarios[scenario] as a slicer. SQL twin context: scenario = policy_2028.
	measure 'Scenario Contribution' = CALCULATE ( SUM ( fact_scenarios[value] ), fact_scenarios[metric] = "contribution" )
		formatString: \$#,##0
		displayFolder: Scenarios
		lineageTag: 837530dd-bc09-5f69-ae8c-0d01d1c32ac7

	column scenario
		dataType: string
		summarizeBy: none
		lineageTag: badaa79b-4b44-5e74-9d2f-1f45d2cf249d
		sourceColumn: scenario

	column metric
		dataType: string
		summarizeBy: none
		lineageTag: cf5be29a-f806-50bf-978b-f1f31cb51daf
		sourceColumn: metric

	column value
		dataType: double
		summarizeBy: sum
		lineageTag: 363bc5d3-e0b2-55b3-9ace-f9c84e3a0b26
		sourceColumn: value

	partition fact_scenarios = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(RepoPath & "\exports\fact_scenarios.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"scenario", type text}, {"metric", type text}, {"value", type number}}, "en-US")
				in
				    Typed

