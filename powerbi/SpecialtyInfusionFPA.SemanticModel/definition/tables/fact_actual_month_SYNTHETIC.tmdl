/// SYNTHETIC data: revenue-cycle method demo only (ADR 0008). No business conclusion.
table fact_actual_month_SYNTHETIC
	lineageTag: 12508b38-b5d0-5cde-b512-f153838177f9

	/// SYNTHETIC actual contribution (method demo). SQL twin context: site S1, months closed.
	measure 'Actual Contribution (SYNTHETIC)' = SUM ( fact_actual_month_SYNTHETIC[contribution] )
		formatString: \$#,##0
		displayFolder: Variance (SYNTHETIC)
		lineageTag: da6eb225-0daf-5129-9b92-b445284e9b31

	/// Budget contribution over the months that have (SYNTHETIC) actuals; the waterfall's starting bar. SQL twin context: site S1, months closed.
	measure 'Budget Contribution to Date' = VAR m = MAX ( fact_actual_month_SYNTHETIC[month_start] ) RETURN CALCULATE ( SUM ( fact_plan_month[contribution] ), fact_plan_month[month_start] <= m )
		formatString: \$#,##0
		displayFolder: Variance (SYNTHETIC)
		lineageTag: 760a80fe-02e0-5ba6-b469-534752d9856b

	/// Actual - budget over the months closed (SYNTHETIC actuals). SQL twin context: site S1, months closed.
	measure 'Contribution Variance (SYNTHETIC)' = VAR m = MAX ( fact_actual_month_SYNTHETIC[month_start] ) RETURN [Actual Contribution (SYNTHETIC)] - CALCULATE ( SUM ( fact_plan_month[contribution] ), fact_plan_month[month_start] <= m )
		formatString: \$#,##0
		displayFolder: Variance (SYNTHETIC)
		lineageTag: 92b002cc-a8c0-57a3-8d9e-c36362f6a147

	/// Change in administrations at budget contribution per administration. SQL twin context: site S1, months closed.
	measure 'Volume Variance (SYNTHETIC)' = VAR m = MAX ( fact_actual_month_SYNTHETIC[month_start] ) VAR ba = CALCULATE ( SUM ( fact_plan_month[admins] ), fact_plan_month[month_start] <= m ) VAR bc = CALCULATE ( SUM ( fact_plan_month[contribution] ), fact_plan_month[month_start] <= m ) RETURN ( SUM ( fact_actual_month_SYNTHETIC[admins] ) - ba ) * DIVIDE ( bc, ba )
		formatString: \$#,##0
		displayFolder: Variance (SYNTHETIC)
		lineageTag: a0cad008-e5f9-5432-9097-58d62b8d1346

	/// Change in payer x drug mix at budget unit contribution. SQL twin context: site S1, months closed.
	measure 'Mix Variance (SYNTHETIC)' = VAR m = MAX ( fact_actual_month_SYNTHETIC[month_start] ) VAR ba = CALCULATE ( SUM ( fact_plan_month[admins] ), fact_plan_month[month_start] <= m ) VAR aa = SUM ( fact_actual_month_SYNTHETIC[admins] ) RETURN SUMX ( VALUES ( dim_item[item_key] ), VAR bi = CALCULATE ( SUM ( fact_plan_month[admins] ), fact_plan_month[month_start] <= m ) VAR bc = CALCULATE ( SUM ( fact_plan_month[contribution] ), fact_plan_month[month_start] <= m ) VAR ai = CALCULATE ( SUM ( fact_actual_month_SYNTHETIC[admins] ) ) RETURN ( ai - aa * DIVIDE ( bi, ba ) ) * DIVIDE ( bc, bi ) )
		formatString: \$#,##0
		displayFolder: Variance (SYNTHETIC)
		lineageTag: 06768abf-3af0-519e-9215-f9f9d8c69d32

	/// Change in contribution per administration (prices, collections, drug cost). SQL twin context: site S1, months closed.
	measure 'Rate Variance (SYNTHETIC)' = VAR m = MAX ( fact_actual_month_SYNTHETIC[month_start] ) RETURN SUMX ( VALUES ( dim_item[item_key] ), VAR bi = CALCULATE ( SUM ( fact_plan_month[admins] ), fact_plan_month[month_start] <= m ) VAR bc = CALCULATE ( SUM ( fact_plan_month[contribution] ), fact_plan_month[month_start] <= m ) VAR ai = CALCULATE ( SUM ( fact_actual_month_SYNTHETIC[admins] ) ) VAR ac = CALCULATE ( SUM ( fact_actual_month_SYNTHETIC[contribution] ) ) RETURN ai * ( DIVIDE ( ac, ai ) - DIVIDE ( bc, bi ) ) )
		formatString: \$#,##0
		displayFolder: Variance (SYNTHETIC)
		lineageTag: 2abe90f5-90ec-58a5-8009-d4d1d2b65314

	column payer
