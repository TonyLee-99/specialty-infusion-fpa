	partition fact_price_path = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(RepoPath & "\exports\fact_price_path.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"hcpcs", type text}, {"basis_quarter", type text}, {"h", Int64.Type}, {"asp", type number}, {"lo80", type number}, {"hi80", type number}, {"model", type text}, {"guard", type text}}, "en-US")
