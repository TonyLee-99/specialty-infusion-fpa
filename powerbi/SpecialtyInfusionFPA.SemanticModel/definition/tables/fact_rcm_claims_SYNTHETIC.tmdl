	column scrubber_edit
		dataType: boolean
		summarizeBy: none
		lineageTag: 4582b9f2-38ae-5cd4-8c1e-df4b55b68311
		sourceColumn: scrubber_edit

	partition fact_rcm_claims_SYNTHETIC = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(RepoPath & "\exports\fact_rcm_claims_SYNTHETIC.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"data_label", type text}, {"claim_id", type text}, {"patient_id", type text}, {"payer", type text}, {"service_date", type date}, {"submit_date", type date}, {"billed_amount", type number}, {"expected_allowed", type number}, {"scrubber_edit", type logical}}, "en-US")
				in
				    Typed

